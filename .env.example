# --- Admin section (/admin) -------------------------------------------------

# Signs the admin session cookie. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# GitHub OAuth app used to sign in (github.com/settings/developers).
# Callback URL: https://<your-domain>/api/admin/auth/callback
# Leave GITHUB_CLIENT_ID unset in local dev to get a one-click local login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The only GitHub account allowed in.
ADMIN_GITHUB_USERNAME=Chukwuemekamusic

# Where saves go. A fine-grained token with "Contents: read and write" on this
# repo. Each save is one commit on GITHUB_BRANCH, which Vercel redeploys.
GITHUB_TOKEN=
GITHUB_REPO=Chukwuemekamusic/my-portfolio
GITHUB_BRANCH=master
# Optional override: "github" or "local". Defaults to github when GITHUB_TOKEN
# is set, otherwise local (writes data/projects.json on disk; dev only).
# PROJECTS_STORE=local

# AI drafts ("Generate with AI").
ANTHROPIC_API_KEY=
